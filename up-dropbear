#!/bin/bash

# Definisikan warna untuk tampilan (bisa disesuaikan dengan script utama kamu)
cyan='\033[0;36m'
light_cyan='\033[1;36m'
green='\033[0;32m'
light_green='\033[1;32m'
yellow='\033[1;33m'
red='\033[1;31m'
bold='\033[1m'
neutral='\033[0m'

function menu_dropbear() {
    clear
    echo -e "${cyan}=======================================${neutral}"
    echo -e "      ${bold}${yellow} UPDATE VERSI DROPBEAR ${neutral}      "
    echo -e "${cyan}=======================================${neutral}"
    echo -e "  ${green}1)${neutral} Dropbear (2017)"
    echo -e "  ${green}2)${neutral} Dropbear (2019)"
    echo -e "  ${green}3)${neutral} Dropbear (2022)"
    echo -e "  ${green}4)${neutral} Dropbear (2024)"
    echo -e "  ${green}5)${neutral} Dropbear (2025)"
    echo -e "  ${green}x)${neutral} Exit to menu"
    echo -e "${cyan}=======================================${neutral}"
    
    read -p "Choose an option [1-5 or x]: " pilihan
    
    case $pilihan in
        1) VERSION="2017.75" ;;
        2) VERSION="2019.78" ;;
        3) VERSION="2022.82" ;;
        4) VERSION="2024.84" ;;
        5) VERSION="2025.87" ;;
        x|X) clear; exit 0 ;;
        *) echo -e "${orange}Invalid choice. Please try again.${neutral}"; sleep 2; menu_dropbear; return ;;
    esac

    # Proses Download dan Install (Diringkas menggunakan variabel agar script lebih pendek & bersih)
    echo -e "\n${green}[*] Mengunduh dan menginstall Dropbear versi $VERSION...${neutral}"
    cd /root || exit
    
    wget -O "dropbear-${VERSION}.tar.bz2" "https://matt.ucc.asn.au/dropbear/releases/dropbear-${VERSION}.tar.bz2"
    if [ ! -f "dropbear-${VERSION}.tar.bz2" ]; then
        echo -e "${orange}[!] Gagal mengunduh file. Periksa koneksi internet!${neutral}"
        exit 1
    fi

    bzip2 -cd "dropbear-${VERSION}.tar.bz2" | tar xvf -
    cd "dropbear-${VERSION}" || exit
    
    ./configure
    make && make install
    
    # Backup dan Linking binary baru
    if [ -f /usr/sbin/dropbear ]; then
        mv /usr/sbin/dropbear /usr/sbin/dropbear1
    fi
    ln -sf /usr/local/sbin/dropbear /usr/sbin/dropbear
    
    # Daftarkan shell jika belum ada
    grep -qxF '/bin/false' /etc/shells || echo "/bin/false" >> /etc/shells
    grep -qxF '/usr/sbin/nologin' /etc/shells || echo "/usr/sbin/nologin" >> /etc/shells
    
    # Restart service
    if [ -f /etc/init.d/dropbear ]; then
        /etc/init.d/dropbear restart
    elif systemctl is-active --quiet dropbear; then
        systemctl restart dropbear
    else
        echo -e "${orange}[!] Service dropbear tidak ditemukan, silakan restart manual.${neutral}"
    fi
    
    # Pembersihan file sampah
    cd /root || exit
    rm -rf "dropbear-${VERSION}" "dropbear-${VERSION}.tar.bz2"
    
    echo -e "\n${green}[✓] Dropbear versi $VERSION berhasil diinstall!${neutral}"
    read -p "Tekan [Enter] untuk kembali ke menu..."
    menu_dropbear
}

# Jalankan fungsi utama
menu_dropbear
